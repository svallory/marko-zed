// Marko 6 smoke-test component: exercises highlighting + LSP diagnostics.
export interface Input {
  name?: string;
  items?: string[];
}

static const MAX_ITEMS = 5;

// Deliberate LSP smoke test: `abobora` is not a real type, so the Marko
// language server should report a diagnostic on the next line. Leave this
// broken on purpose — it proves type-checking is wired up end to end.
static function shout(text: abobora) {
  return text.toUpperCase();
}

-- Concise-mode header, before the file switches to HTML mode below.
p.tagline -- rendered ${new Date().getFullYear()}

<let/count = 0>
<const/greeting = `Hello, ${shout(input.name ?? "world")}!`>

<div.greeting>
  <h1>${greeting}</h1>

  <if=input.items?.length>
    <ul>
      <for|item, i| of=input.items.slice(0, MAX_ITEMS)>
        <li>${i + 1}. ${item}</li>
      </for>
    </ul>
  </if>
  <else if=(count > 0)>
    <p>Cleared ${count} item(s).</p>
  </else>
  <else>
    <p>No items yet.</p>
  </else>

  <button onClick() { count++ }>Bump count (${count})</button>

  <!-- Dynamic tag: renders as <span> or <strong> depending on state. -->
  <${count > 3 ? "strong" : "span"}>Count is ${count}</>

  <!-- Attribute tag: <@icon> is only meaningful as a child of a custom
       tag, since it becomes a property on that tag's `input.icon` —
       `fancy-card` is a real custom tag discovered from src/tags/, so
       this compiles for real and renders the icon name inside the card. -->
  <fancy-card title="Card">
    <@icon name="star"/>
    <p>Try the <a href="/Saulo">params route</a> too.</p>
  </fancy-card>
</div>

<style>
  .greeting {
    color: teal;
  }
</style>
